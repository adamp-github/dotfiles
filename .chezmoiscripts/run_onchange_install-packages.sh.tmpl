{{- $p := get .profiles .profile -}}
{{- if not $p }}{{ fail (printf "unknown profile %q; add it to .chezmoidata/profiles.yaml" .profile) }}{{ end -}}
#!/bin/bash
set -euo pipefail

# Install extra packages via Omarchy's wrapper. LibreWolf is in Arch's extra
# repo, so it goes through pacman (the AUR-only librewolf-bin is not needed).
omarchy pkg add librewolf

# Ensure LibreWolf stays registered as default
xdg-mime default librewolf.desktop x-scheme-handler/http x-scheme-handler/https text/html

{{ if $p.packages.plex -}}
# Plex desktop client (AUR), desktop only. squashfs-tools is a makedep;
# yay needs it to unpack Plex's snap before packaging.
omarchy pkg add squashfs-tools
omarchy pkg aur add plex-desktop

{{ end -}}
# Tailscale mesh VPN. Logging in is left to the user: `tailscale up` waits for
# browser authentication, which would block chezmoi apply.
omarchy pkg add tailscale
sudo systemctl enable --now tailscaled.service

# Scanners used by the global git hooks in ~/.config/git/hooks
omarchy pkg add gitleaks shellcheck uv
# semgrep is not packaged for Arch, so install the official PyPI build with uv
command -v semgrep >/dev/null || uv tool install semgrep

# Custom web apps. The third argument is the icon; an empty string means
# "fetch the site's icon", and it keeps the command from dropping into
# interactive prompts when run from chezmoi.
omarchy-webapp-install "Apple Notes" "https://www.icloud.com/notes" ""
omarchy-webapp-install "Apple Photos" "https://www.icloud.com/photos" ""
omarchy-webapp-install "Apple iCloud Drive" "https://www.icloud.com/iclouddrive" ""
omarchy-webapp-install "Apple iCloud" "https://www.icloud.com" ""
