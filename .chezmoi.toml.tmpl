# Generated by `chezmoi init` from the dotfiles repo. The profile selects a
# block in .chezmoidata/profiles.yaml; unknown hosts fall back to the laptop
# profile because it installs the least. Override with `chezmoi edit-config`.
{{ $hosts := dict "dl7390" "personal-laptop" "5800x" "personal-desktop" }}
{{- $profile := get $hosts .chezmoi.hostname | default "personal-laptop" }}
[data]
    profile = {{ $profile | quote }}
